+        raise RuntimeError('Four confirmed bilingual identity fields required')
+    if spec.get('base_model') != 'Qwen/Qwen3-8B':
+        raise RuntimeError('Unexpected base identity')
+    return {k:spec[k] for k in (*FIELDS, 'base_model')}
+
