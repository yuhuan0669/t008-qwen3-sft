+        if index>=identity_start:
+            tokens+=re.findall(r'\{\{\s*(?:name|author|authoer)\s*\}\}',text,re.I)
+        if tokens or 'swift-robot' in text:
+            findings.append({'index':index,'tokens':sorted(set(tokens)),
+                             'swift_robot':'swift-robot' in text})
+    return findings
