        "name": "model-store",
        "persistentVolumeClaim": {
          "claimName": "vllm-released",
          "readOnly": true
        }
      },
      {
        "emptyDir": {
          "medium": "Memory",
          "sizeLimit": "8Gi"
        },
        "name": "dshm"
      },
      {
        "hostPath": {
          "path": "/etc/localtime",
          "type": "File"
        },
        "name": "host-localtime"
      },
      {
        "configMap": {
          "defaultMode": 420,
          "name": "t008-v0114-20261021-publish01-template"
        },
        "name": "t008-serving-template"
      }
    ],
    "activeDeadlineSeconds": 7200
  }
