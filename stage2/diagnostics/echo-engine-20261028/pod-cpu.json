{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "t024-echo80-cpu-20261028",
    "namespace": "vllm",
    "labels": {
      "t024-diagnostic": "echo-engine-20261028"
    }
  },
  "spec": {
    "automountServiceAccountToken": false,
    "containers": [
      {
        "command": [
          "python3",
          "-c",
          "import time;from pathlib import Path;Path('/tmp/echo80').mkdir(exist_ok=True);time.sleep(7100)"
        ],
        "env": [
          {
            "name": "HF_HUB_OFFLINE",
            "value": "1"
          },
          {
            "name": "HF_HOME",
            "value": "/tmp/hf"
          },
          {
            "name": "TZ",
            "value": "America/Los_Angeles"
          },
          {
            "name": "TORCHINDUCTOR_CACHE_DIR",
            "value": "/tmp/torchinductor_vllm"
          },
          {
            "name": "VLLM_CACHE_ROOT",
            "value": "/tmp/vllm"
          },
          {
            "name": "XDG_CACHE_HOME",
            "value": "/tmp/cache"
          },
          {
            "name": "PYTHONUNBUFFERED",
            "value": "1"
          },
          {
            "name": "TOKENIZERS_PARALLELISM",
            "value": "false"
          },
          {
            "name": "OMP_NUM_THREADS",
            "value": "4"
          },
          {
            "name": "CUDA_VISIBLE_DEVICES",
            "value": ""
          },
          {
            "name": "NVIDIA_VISIBLE_DEVICES",
            "value": "void"
          }
        ],
        "image": "modelscope-registry.cn-hangzhou.cr.aliyuncs.com/modelscope-repo/modelscope@sha256:822d99beed4984a421c8d1da397993c6a8a5f88cdad7dde940bd52df0067d738",
        "imagePullPolicy": "IfNotPresent",
        "name": "runtime",
        "resources": {
          "requests": {
            "cpu": "1",
            "memory": "2Gi"
          },
          "limits": {
            "cpu": "4",
            "memory": "8Gi"
          }
        },
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          },
          "runAsGroup": 10002,
          "runAsNonRoot": true,
          "runAsUser": 10002
        },
        "terminationMessagePath": "/dev/termination-log",
        "terminationMessagePolicy": "File",
        "volumeMounts": [
          {
            "mountPath": "/models",
            "name": "model-store",
            "readOnly": true,
            "subPath": "released/qwen3-8b-baseline/model"
          },
          {
            "mountPath": "/dev/shm",
            "name": "dshm"
          },
          {
            "mountPath": "/etc/localtime",
            "name": "host-localtime",
            "readOnly": true
          },
          {
            "mountPath": "/adapters/octa-carbon-sft-v0114",
            "name": "model-store",
            "readOnly": true,
            "subPath": "released/t008-v0114-20261021-publish01/adapter"
          },
          {
            "mountPath": "/t008-serving",
            "name": "t008-serving-template",
            "readOnly": true
          }
        ]
      }
    ],
    "dnsPolicy": "ClusterFirst",
    "nodeSelector": {
      "kubernetes.io/hostname": "k8s-worker05"
    },
    "restartPolicy": "Never",
    "schedulerName": "default-scheduler",
    "securityContext": {
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "serviceAccount": "vllm-inference",
    "serviceAccountName": "vllm-inference",
    "terminationGracePeriodSeconds": 15,
    "tolerations": [
      {
        "effect": "NoSchedule",
        "key": "dedicated",
