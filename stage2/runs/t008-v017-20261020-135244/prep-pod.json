{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "t008-v017-20261020-135244-prep",
    "namespace": "swift",
    "labels": {
      "t008-run": "t008-v017-20261020-135244",
      "stage": "cpu-prep"
    }
  },
  "spec": {
    "restartPolicy": "Never",
    "automountServiceAccountToken": false,
    "nodeSelector": {
      "kubernetes.io/hostname": "k8s-worker05"
    },
    "tolerations": [
      {
        "key": "dedicated",
        "operator": "Equal",
        "value": "gpu-rtx4090",
        "effect": "NoSchedule"
      }
    ],
    "containers": [
      {
        "name": "prep",
        "image": "modelscope-registry.cn-hangzhou.cr.aliyuncs.com/modelscope-repo/modelscope@sha256:822d99beed4984a421c8d1da397993c6a8a5f88cdad7dde940bd52df0067d738",
        "command": [
          "sleep",
          "36000"
        ],
        "env": [
          {
            "name": "CUDA_VISIBLE_DEVICES",
            "value": ""
          },
          {
            "name": "NVIDIA_VISIBLE_DEVICES",
            "value": "void"
          }
        ],
        "resources": {
          "requests": {
            "cpu": "500m",
            "memory": "1Gi"
          },
          "limits": {
            "cpu": "2",
            "memory": "8Gi"
          }
        },
        "volumeMounts": [
          {
            "name": "data",
            "mountPath": "/data"
          },
          {
            "name": "work",
            "mountPath": "/work"
          },
          {
            "name": "base",
            "mountPath": "/base",
            "subPath": "Qwen3-8B",
            "readOnly": true
          }
        ]
      }
    ],
    "volumes": [
      {
        "name": "data",
        "persistentVolumeClaim": {
          "claimName": "swift-train-data"
        }
      },
      {
        "name": "work",
        "persistentVolumeClaim": {
          "claimName": "swift-work"
        }
      },
      {
        "name": "base",
        "persistentVolumeClaim": {
          "claimName": "swift-base",
          "readOnly": true
        }
      }
    ]
  }
}
